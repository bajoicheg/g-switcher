{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdc:agent-task:v1",
  "title": "CDC provider-neutral agent task v1",
  "description": "Input only. Native admission remains authoritative. Python validation additionally enforces portable aliases, Unicode path metadata protection, no self dependency and reviewer head_sha == base_sha.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "project_id",
    "repository",
    "base_sha",
    "branch",
    "worktree",
    "objective",
    "acceptance_criteria",
    "allowed_files",
    "allowed_operations",
    "provider",
    "model",
    "role",
    "execution_profile",
    "security_classification",
    "budget",
    "limits",
    "dependencies",
    "required_tests",
    "review",
    "artifacts",
    "review_of"
  ],
  "properties": {
    "schema": {
      "const": "cdc-agent-task/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
    },
    "repository": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}/)[A-Za-z0-9_.-]+/(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:refs/heads/)?(?!(?:[Mm][Aa][Ii][Nn]|[Mm][Aa][Ss][Tt][Ee][Rr]|[Rr][Ee][Ll][Ee][Aa][Ss][Ee][Ss]?|[Pp][Rr][Oo][Tt][Ee][Cc][Tt][Ee][Dd])(?:/|$))(?!refs/)(?!.*[.][.])(?!.*@\\{)(?!.*(?:^|/)[.])(?!.*[.]lock(?:/|$))(?!.*[./]$)[^ ~^:?*\\[\\\\\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "worktree": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[.]git(?:/|$))(?!.*//)(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[^\\\\<>:\"|?*\\u0000-\\u001f\\u007f]+(?<!/)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*\\S)?$"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*\\S)?$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[.]git(?:/|$))(?!.*//)(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[^\\\\<>:\"|?*\\u0000-\\u001f\\u007f]+(?<!/)$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "edit"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provider": {
      "enum": [
        "codex",
        "gemini",
        "kimi"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
    },
    "role": {
      "enum": [
        "developer",
        "reviewer"
      ]
    },
    "execution_profile": {
      "enum": [
        "workspace-write",
        "read-only"
      ]
    },
    "security_classification": {
      "enum": [
        "synthetic",
        "public"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_starts",
        "tokens",
        "cost_units"
      ],
      "properties": {
        "agent_starts": {
          "type": "integer",
          "const": 1
        },
        "tokens": {
          "type": "null"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "retry_limit"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retry_limit": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "provider",
        "max_iterations"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "codex",
            "gemini",
            "kimi"
          ]
        },
        "max_iterations": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[.]git(?:/|$))(?!.*//)(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[^\\\\<>:\"|?*\\u0000-\\u001f\\u007f]+(?<!/)$"
        }
      }
    },
    "review_of": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_sha",
            "head_sha",
            "developer_provider",
            "test_evidence"
          ],
          "properties": {
            "base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "developer_provider": {
              "enum": [
                "codex",
                "gemini",
                "kimi"
              ]
            },
            "test_evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "developer"
          }
        }
      },
      "then": {
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:refs/heads/)?(?!(?:[Mm][Aa][Ii][Nn]|[Mm][Aa][Ss][Tt][Ee][Rr]|[Rr][Ee][Ll][Ee][Aa][Ss][Ee][Ss]?|[Pp][Rr][Oo][Tt][Ee][Cc][Tt][Ee][Dd])(?:/|$))(?!refs/)(?!.*[.][.])(?!.*@\\{)(?!.*(?:^|/)[.])(?!.*[.]lock(?:/|$))(?!.*[./]$)[^ ~^:?*\\[\\\\\\u0000-\\u001f\\u007f]+$"
          },
          "worktree": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[.]git(?:/|$))(?!.*//)(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[^\\\\<>:\"|?*\\u0000-\\u001f\\u007f]+(?<!/)$"
          },
          "execution_profile": {
            "const": "workspace-write"
          },
          "allowed_files": {
            "minItems": 1
          },
          "allowed_operations": {
            "minItems": 2,
            "maxItems": 2
          },
          "review_of": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "reviewer"
          }
        }
      },
      "then": {
        "properties": {
          "branch": {
            "type": "null"
          },
          "worktree": {
            "type": "null"
          },
          "execution_profile": {
            "const": "read-only"
          },
          "allowed_files": {
            "maxItems": 0
          },
          "allowed_operations": {
            "const": [
              "read"
            ]
          },
          "review_of": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base_sha",
              "head_sha",
              "developer_provider",
              "test_evidence"
            ],
            "properties": {
              "base_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "head_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "developer_provider": {
                "enum": [
                  "codex",
                  "gemini",
                  "kimi"
                ]
              },
              "test_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "required_tests": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "codex"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "provider": {
                "enum": [
                  "gemini",
                  "kimi"
                ]
              }
            }
          },
          "review_of": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "developer_provider": {
                    "enum": [
                      "gemini",
                      "kimi"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "gemini"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "provider": {
                "enum": [
                  "codex",
                  "kimi"
                ]
              }
            }
          },
          "review_of": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "developer_provider": {
                    "enum": [
                      "codex",
                      "kimi"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "kimi"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "provider": {
                "enum": [
                  "codex",
                  "gemini"
                ]
              }
            }
          },
          "review_of": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "developer_provider": {
                    "enum": [
                      "codex",
                      "gemini"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
